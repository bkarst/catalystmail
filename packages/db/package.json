{
  "name": "@catalyst/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and ID generation for Catalyst (spec §6).",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
