  },
  "dependencies": {
    "@catalyst/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "kysely": "0.29.8",
    "pg": "^8.23.1",
    "typeid-js": "^1.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
