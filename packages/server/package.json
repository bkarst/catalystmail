    "@catalyst/jobs": "workspace:*",
    "@catalyst/mcp": "workspace:*",
    "@catalyst/storage": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hoodiecrow-imap": "^3.3.1",
    "imapflow": "^2.11.0"
