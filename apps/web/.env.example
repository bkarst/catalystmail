# Copy to .env.local for development.

# PostgreSQL 16+ with the citext and pg_trgm extensions available.
# Apply migrations first: pnpm --filter @catalyst/db migrate
DATABASE_URL=postgres://postgres@127.0.0.1:5432/catalyst

# AES-256-GCM keys for credentials at rest, newest last: version:base64 (32 bytes).
# node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=

# Public base URL; its host is the default tracking CNAME target and unsubscribe host.
APP_URL=http://localhost:3000
# Sign-in for people (Better Auth, §16): signs session cookies. Without it only API keys work.
# Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Browser push for urgent and high alerts (§11.2). Make a pair with
# `pnpm --filter @catalyst/server catalyst vapid-keys`; the worker and the app need the same pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# Mailbox sign-in with Google Workspace or Microsoft 365 (XOAUTH2, §7.1). The redirect URI to
# register is APP_URL/api/v1/oauth/google/callback (or /microsoft/callback). The worker needs them too.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

# Where imports and raw email are stored in development (S3/MinIO in production).
STORAGE_DIR=.storage
# S3 or MinIO instead of the filesystem: set the bucket (and, for MinIO, the endpoint). Without
# the keys, the AWS SDK's own credential chain is used.
# S3_BUCKET=catalyst
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional: a Spamhaus Data Query Service key, required for commercial blocklist lookups (§8.10).
# SPAMHAUS_DQS_KEY=
# Transactional mail from Catalyst itself (alerts, digests, invites), never a sending mailbox (§11.2).
# SYSTEM_SMTP_URL=smtps://user:password@smtp.example.com:465
# SYSTEM_FROM=Catalyst <alerts@example.com>
# The AI agent (§10): set AI_ENABLED=true and Claude API credentials (ANTHROPIC_API_KEY) on the worker.
# AI_ENABLED=false
# ANTHROPIC_API_KEY=
# Jev, TypeSafe's classifier (§10.4): runs first on each reply when both are set. Pin an exact
# version; jev-latest leaves it off. Billed per call.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.13.0
